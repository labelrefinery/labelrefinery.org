{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "labelrefinery-org",
  "compatibility_date": "2026-08-31",
  // One small Worker, for `/ph/*` only -- the first-party PostHog proxy.
  // `assets.run_worker_first` below keeps it off every other path, so the
  // site stays a plain static-asset deployment with no per-request Worker
  // invocation. Same arrangement as magmalake.org.
  "main": "worker/posthog-proxy.js",
  // Keep the workers.dev URL alive as a fallback -- attaching the custom
  // domain on a brand-new zone took the site offline once already.
  "workers_dev": true,
  // Astro builds to dist/; everything but /ph/* is served straight from it.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/ph/*"]
  },
  // Both hostnames serve the site; every page emits <link rel="canonical">
  // pointing at the apex, so search engines are not offered two copies.
  // The earlier outage was the zone's universal certificate not yet issued,
  // not the second hostname: one cert covers apex and www together, and it
  // only went valid ~an hour after the zone activated.
  "routes": [
    { "pattern": "labelrefinery.org", "custom_domain": true },
    { "pattern": "www.labelrefinery.org", "custom_domain": true }
  ]
}
