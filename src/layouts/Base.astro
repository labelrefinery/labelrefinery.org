---
import "../styles/global.css";
import { POSTHOG_KEY } from "../data/site";

const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const posthogEnabled = POSTHOG_KEY.startsWith("phc_");

const nav = [
  { href: "/", label: "Overview" },
  { href: "/data", label: "The data" },
  { href: "/pipelines", label: "Pipelines" },
  { href: "/datasets", label: "Datasets" },
  { href: "/results", label: "Numbers & learnings" },
  { href: "/papers", label: "Papers" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(path, Astro.site)} />

    {/*
      PostHog product analytics, proxied first-party through /ph (see
      worker/posthog-proxy.js) so ad-blockers don't drop it. `persistence:
      'memory'` means no cookies and no localStorage, so there is nothing to
      disclose and no consent banner is needed. `api_host` is derived from
      `location.origin` at runtime rather than hardcoded so this works the
      same on the apex domain, on www., and under `wrangler dev`.
    */}
    {posthogEnabled && (
      <>
        <script defer src="/ph/static/array.js"></script>
        <script is:inline define:vars={{ POSTHOG_KEY }}>
          window.addEventListener("DOMContentLoaded", function () {
            if (window.posthog) posthog.init(POSTHOG_KEY, {
              api_host: location.origin + '/ph',
              ui_host: 'https://us.posthog.com',
              defaults: '2025-05-24',
              persistence: 'memory',
              capture_exceptions: true
            });
          });
        </script>
      </>
    )}
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">labelrefinery</a>
        <nav>
          {
            nav.map((item) => (
              <a href={item.href} aria-current={path === item.href ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
          <a href="https://demo.labelrefinery.org">Demo</a>
          <a href="https://github.com/labelrefinery">GitHub</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site">
      <div class="wrap">
        <p>
          Offboard auto-labeling for construction sites. Code on
          <a href="https://github.com/labelrefinery">GitHub</a>, Apache 2.0.
          The loop runs live at
          <a href="https://demo.labelrefinery.org">demo.labelrefinery.org</a>.
          Not affiliated with any of the papers implemented here.
        </p>
      </div>
    </footer>
  </body>
</html>
